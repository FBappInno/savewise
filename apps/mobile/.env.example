EXPO_PUBLIC_API_URL=http://localhost:3001
# Optional separate self-hosted endpoint. Falls omitted, EXPO_PUBLIC_API_URL is used.
EXPO_PUBLIC_ANALYTICS_API_URL=https://analytics.example.com
# Public Dropbox OAuth app key. Never add the Dropbox app secret to a mobile build.
EXPO_PUBLIC_DROPBOX_APP_KEY=your_dropbox_app_key
