{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": "..",
    "paths": {
      "@savewise/shared": [
        "packages/shared/src/index.ts"
      ],
      "@savewise/shared/*": [
        "packages/shared/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}